data:
  name: megadepth
  preprocessing:
    resize: 1024
    side: long
    square_pad: true
  train_split: train_scenes_clean.txt
  train_num_per_scene: 300
  val_split: valid_scenes_clean.txt
  val_pairs: valid_pairs.txt
  min_overlap: 0.1
  max_overlap: 0.7
  num_overlap_bins: 3
  read_depth: true
  read_image: true
  batch_size: 16
  num_workers: 4
  load_features:
    do: true
    path: exports/megadepth-undist-depth-r1024_SP-k1024-nms3/{scene}.h5
    padding_length: 1024
    padding_fn: pad_local_features
model:
  name: two_view_pipeline
  run_gt_in_forward: true
  extractor:
    name: extractors.superpoint
    max_num_keypoints: 1024
    force_num_keypoints: true
    detection_threshold: 0.0
    nms_radius: 3
    trainable: false
  ground_truth:
    name: matchers.depth_matcher
    th_positive: 3
    th_negative: 5
    th_epi: 5
  diffuser:
    name: diffusers.diffuser
    steps: 4096
    learn_sigma: false
    sigma_small: false
    noise_schedule: linear
    use_kl: false
    predict_xstart: true
    rescale_timesteps: true
    rescale_learned_sigmas: true
    timestep_respacing: ''
    ddim_steps: 2
    schedule_sampler: uniform
    use_ddim: true
    clip_denoised: true
    diffuser_loss_weight: 1
    scale: 2
  matcher:
    name: matchers.diffglue
    filter_threshold: 0.1
    flash: true
    checkpointed: true
    n_layers: 9
    scale: 2
    epipolar: enabled
    epi_weight: 1.0
    matcher_loss_weight: 0.1
    loftr_pretrained: outdoor_ds.ckpt
    freeze_loftr_backbone: true
    freeze_loftr_coarse: false
  allow_no_extract: true
  refinement:
    num_refinement_iters: 3
    use_geometry_guidance: true
    geometry_guidance_weight: 0.1
    feedback_to_loftr: true
    feedback_scale: 0.5
    geometry_error_type: sampson
    min_matches_for_E: 8
    top_k_candidates: 500
    reliability_threshold: 0.1
    init_from_previous: true
    unrolled_training: true
    unrolled_k: 2
    unrolled_t: 4
    loss_match_weight: 1.0
    loss_pose_weight: 0.1
    warmup_epochs: 20
    unfreeze_backbone_after_warmup: true
    backbone_lr_factor: 0.1
train:
  seed: 0
  epochs: 40
  optimizer: adam
  opt_regexp: null
